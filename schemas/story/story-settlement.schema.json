{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://directive.local/schemas/story/story-settlement.schema.json",
  "title": "Directive V1 Story Settlement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "branchId",
    "revision",
    "activeEpisode",
    "episodes",
    "receipts",
    "focus"
  ],
  "properties": {
    "kind": { "const": "directive.storySettlement.v1" },
    "schemaVersion": { "const": 1 },
    "branchId": { "$ref": "../common/common.schema.json#/$defs/id" },
    "revision": { "type": "integer", "minimum": 0 },
    "activeEpisode": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "episodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/episode" }
    },
    "receipts": {
      "type": "array",
      "items": { "$ref": "#/$defs/receipt" }
    },
    "focus": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/focus" }
      ]
    }
  },
  "$defs": {
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codes": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "../common/common.schema.json#/$defs/id" }
        },
        "lastError": {
          "type": ["string", "null"],
          "maxLength": 512
        }
      }
    },
    "sourceContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "messageId",
        "swipeId",
        "role",
        "textHash",
        "acceptedAtRevision"
      ],
      "properties": {
        "id": { "$ref": "../common/common.schema.json#/$defs/id" },
        "messageId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "swipeId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant", "runtime", "adjudicator"]
        },
        "textHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{32,128}$"
        },
        "acceptedAtRevision": { "type": "integer", "minimum": 0 }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "targetId",
        "sourceContributionIds",
        "playerVisibility",
        "status"
      ],
      "properties": {
        "id": { "$ref": "../common/common.schema.json#/$defs/id" },
        "type": { "$ref": "../common/common.schema.json#/$defs/id" },
        "targetId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "sourceContributionIds": {
          "type": "array",
          "items": { "$ref": "../common/common.schema.json#/$defs/id" },
          "uniqueItems": true
        },
        "playerVisibility": {
          "type": "string",
          "enum": ["visible", "hidden"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "invalidated"]
        },
        "value": {
          "type": ["string", "number", "boolean", "null"]
        }
      }
    },
    "consequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "playerVisibility"],
      "properties": {
        "id": { "$ref": "../common/common.schema.json#/$defs/id" },
        "status": {
          "type": "string",
          "enum": ["unresolved", "resolved", "invalidated"]
        },
        "playerVisibility": {
          "type": "string",
          "enum": ["visible", "hidden"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "episodeBoundaryState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "checkpointSequence",
        "lastReviewedAtRevision",
        "contributionCountAtLastReview",
        "effectCountAtLastReview",
        "decision",
        "sourceContributionIds"
      ],
      "properties": {
        "kind": { "const": "directive.episodeBoundaryState.v1" },
        "checkpointSequence": { "type": "integer", "minimum": 0 },
        "lastReviewedAtRevision": { "type": "integer", "minimum": 0 },
        "contributionCountAtLastReview": { "type": "integer", "minimum": 0 },
        "effectCountAtLastReview": { "type": "integer", "minimum": 0 },
        "decision": { "const": "continue" },
        "sourceContributionIds": {
          "type": "array",
          "items": { "$ref": "../common/common.schema.json#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "episodeHardBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "branchId", "code", "source", "sourceContributionIds"],
      "properties": {
        "kind": { "const": "directive.episodeHardBoundary.v1" },
        "id": { "$ref": "../common/common.schema.json#/$defs/id" },
        "branchId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "code": {
          "type": "string",
          "enum": [
            "mission-transition",
            "authored-scene-closure",
            "save-branch-change",
            "major-time-jump",
            "meaningful-location-transition",
            "world-settlement",
            "source-recovery"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
            "id": { "$ref": "../common/common.schema.json#/$defs/id" }
          }
        },
        "sourceContributionIds": {
          "type": "array",
          "items": { "$ref": "../common/common.schema.json#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "episodeReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missionIds", "questIds", "participantIds", "locationIds"],
      "properties": {
        "missionIds": {
          "type": "array",
          "items": { "$ref": "../common/common.schema.json#/$defs/id" },
          "uniqueItems": true
        },
        "questIds": {
          "type": "array",
          "items": { "$ref": "../common/common.schema.json#/$defs/id" },
          "uniqueItems": true
        },
        "participantIds": {
          "type": "array",
          "items": { "$ref": "../common/common.schema.json#/$defs/id" },
          "uniqueItems": true
        },
        "locationIds": {
          "type": "array",
          "items": { "$ref": "../common/common.schema.json#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "episodeSoftBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "significanceCriteria", "sourceContributionIds", "effectIds", "checkpointSequence"],
      "properties": {
        "kind": { "const": "directive.episodeSoftBoundary.v1" },
        "reason": {
          "type": "string",
          "enum": [
            "foreground-question-resolved",
            "foreground-question-abandoned",
            "encounter-departure",
            "material-situation-shift",
            "sustained-context-replacement"
          ]
        },
        "significanceCriteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "material-state-change",
              "consequential-fact-learned",
              "commitment-created-or-resolved",
              "relationship-turning-point",
              "future-constraining-decision",
              "lasting-cost-gain-or-loss",
              "unresolved-consequence"
            ]
          }
        },
        "sourceContributionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "../common/common.schema.json#/$defs/id" }
        },
        "effectIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "../common/common.schema.json#/$defs/id" }
        },
        "checkpointSequence": { "type": "integer", "minimum": 1 }
      }
    },
    "characterMoment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "characterId", "summary", "playerVisibility", "sourceContributionIds"],
      "properties": {
        "id": { "$ref": "../common/common.schema.json#/$defs/id" },
        "characterId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
        "playerVisibility": { "type": "string", "enum": ["visible", "hidden"] },
        "sourceContributionIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "../common/common.schema.json#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "workingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contributionId", "role", "textHash", "excerpt"],
      "properties": {
        "contributionId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "role": {
          "type": "string",
          "enum": ["user", "assistant", "runtime", "adjudicator"]
        },
        "textHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{32,128}$"
        },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "workingCapsule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "foregroundQuestion",
        "sourceContributionIds",
        "effectIds",
        "recentEvidence",
        "observedContributionCount",
        "lastEvaluatedCheckpointSequence",
        "needsReview",
        "updatedAtRevision"
      ],
      "properties": {
        "kind": { "const": "directive.storyWorkingCapsule.v1" },
        "summary": { "type": "string", "maxLength": 768 },
        "foregroundQuestion": { "type": ["string", "null"], "minLength": 1, "maxLength": 240 },
        "sourceContributionIds": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "../common/common.schema.json#/$defs/id" },
          "uniqueItems": true
        },
        "effectIds": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "../common/common.schema.json#/$defs/id" },
          "uniqueItems": true
        },
        "recentEvidence": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/workingEvidence" }
        },
        "observedContributionCount": { "type": "integer", "minimum": 0 },
        "lastEvaluatedCheckpointSequence": { "type": "integer", "minimum": 0 },
        "needsReview": { "type": "boolean" },
        "updatedAtRevision": { "type": "integer", "minimum": 0 }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "branchId",
        "sceneId",
        "status",
        "openedAtRevision",
        "sealedAtRevision",
        "boundaryReason",
        "summary",
        "contributions",
        "effects",
        "unresolvedConsequences"
      ],
      "properties": {
        "kind": { "const": "directive.storyEpisode.v1" },
        "id": { "$ref": "../common/common.schema.json#/$defs/id" },
        "branchId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "sceneId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "status": {
          "type": "string",
          "enum": ["open", "sealPending", "recoveryRequired", "sealed", "invalidated"]
        },
        "openedAtRevision": { "type": "integer", "minimum": 0 },
        "sealedAtRevision": { "type": ["integer", "null"], "minimum": 0 },
        "boundaryReason": { "type": ["string", "null"], "maxLength": 128 },
        "summary": { "type": ["string", "null"], "maxLength": 1024 },
        "contributions": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceContribution" }
        },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" }
        },
        "unresolvedConsequences": {
          "type": "array",
          "items": { "$ref": "#/$defs/consequence" }
        },
        "boundaryState": { "$ref": "#/$defs/episodeBoundaryState" },
        "hardBoundary": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/episodeHardBoundary" }
          ]
        },
        "softBoundary": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/episodeSoftBoundary" }
          ]
        },
        "references": { "$ref": "#/$defs/episodeReferences" },
        "characterMoments": {
          "type": "array",
          "items": { "$ref": "#/$defs/characterMoment" }
        },
        "workingCapsule": { "$ref": "#/$defs/workingCapsule" },
        "supersedesEpisodeId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "supersedesEpisodeIds": {
          "type": "array",
          "items": { "$ref": "../common/common.schema.json#/$defs/id" },
          "uniqueItems": true
        },
        "invalidationReason": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "diagnostics": { "$ref": "#/$defs/diagnostics" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "branchId",
        "sceneId",
        "disposition",
        "episodeId",
        "sourceContributionIds",
        "sourceMessageIds",
        "settledAtRevision"
      ],
      "properties": {
        "kind": { "const": "directive.storySettlementReceipt.v1" },
        "id": { "$ref": "../common/common.schema.json#/$defs/id" },
        "branchId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "sceneId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "disposition": {
          "type": "string",
          "enum": ["sealed", "insignificant", "invalidated"]
        },
        "episodeId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "sourceContributionIds": {
          "type": "array",
          "items": { "$ref": "../common/common.schema.json#/$defs/id" },
          "uniqueItems": true
        },
        "sourceMessageIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 300 },
          "uniqueItems": true
        },
        "settledAtRevision": { "type": "integer", "minimum": 0 },
        "diagnostics": { "$ref": "#/$defs/diagnostics" }
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "branchId",
        "episodeId",
        "consequenceId",
        "setAtRevision"
      ],
      "properties": {
        "kind": { "const": "directive.emergentFocus.v1" },
        "id": { "$ref": "../common/common.schema.json#/$defs/id" },
        "branchId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "episodeId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "consequenceId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "setAtRevision": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
