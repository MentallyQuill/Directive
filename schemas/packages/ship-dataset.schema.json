{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://directive.local/schemas/packages/ship-dataset.schema.json",
  "title": "Directive V1 Ship Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "profile"],
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "id", "packageId", "shipId", "classId", "title", "version"],
      "properties": {
        "kind": { "const": "directive.shipDataset.v1" },
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "../common/common.schema.json#/$defs/id" },
        "packageId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "shipId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "classId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "title": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
        "version": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "narrationGuide", "hardFacts"],
      "properties": {
        "summary": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
        "narrationGuide": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
        "hardFacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" }
        }
      }
    }
  }
}
