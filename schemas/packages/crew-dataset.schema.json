{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://directive.local/schemas/packages/crew-dataset.schema.json",
  "title": "Directive V1 Crew Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "officers"],
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "id", "packageId", "title", "version"],
      "properties": {
        "kind": { "const": "directive.crewDataset.v1" },
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "../common/common.schema.json#/$defs/id" },
        "packageId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "title": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
        "version": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "officers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/officer" }
    },
    "supportingCharacters": {
      "description": "Narration-only cast guidance; entries do not introduce a person or create a public dossier.",
      "type": "array",
      "items": { "$ref": "#/$defs/supportingCharacter" }
    }
  },
  "$defs": {
    "officer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "billet", "profileSummary", "narrationGuide"],
      "properties": {
        "id": { "$ref": "../common/common.schema.json#/$defs/id" },
        "name": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
        "billet": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
        "categoryId": { "$ref": "../common/common.schema.json#/$defs/id" },
        "species": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["organization", "department", "rankCode", "rankLabel"],
          "properties": {
            "organization": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
            "department": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
            "rankCode": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
            "rankLabel": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" }
          }
        },
        "publicRecord": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "age": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
            "birthplace": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
            "serviceBackground": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
            "assignmentHistory": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" }
          }
        },
        "profileSummary": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
        "narrationGuide": { "$ref": "#/$defs/narrationGuide" }
      }
    },
    "supportingCharacter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "narrationGuide"],
      "properties": {
        "id": { "$ref": "../common/common.schema.json#/$defs/id" },
        "name": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
        "narrationGuide": { "$ref": "#/$defs/narrationGuide" }
      }
    },
    "narrationGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice", "constraints"],
      "properties": {
        "voice": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" }
        },
        "characterReference": { "$ref": "#/$defs/characterReference" }
      }
    },
    "characterReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character", "source", "drawFrom", "boundaries"],
      "properties": {
        "character": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
        "source": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
        "drawFrom": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" },
        "boundaries": { "$ref": "../common/common.schema.json#/$defs/nonEmptyString" }
      }
    }
  }
}
