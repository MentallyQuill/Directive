{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://directive.local/schemas/campaign-package-v1.schema.json",
  "title": "Directive V1 Campaign Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest",
    "campaign",
    "ship",
    "crew",
    "characterCreation",
    "world",
    "guardrails",
    "assets"
  ],
  "properties": {
    "manifest": {
      "type": "object",
      "required": [
        "kind",
        "schemaVersion",
        "id",
        "slug",
        "title",
        "version",
        "status",
        "bundled",
        "openingMissionId",
        "openingMinuteOfDay"
      ],
      "properties": {
        "kind": { "const": "directive.campaignPackage.v1" },
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "bundled": { "const": true },
        "openingMissionId": { "type": "string", "minLength": 1 },
        "openingMinuteOfDay": { "type": "integer", "minimum": 0, "maximum": 1439 }
      }
    },
    "campaign": {
      "type": "object",
      "required": ["id", "title", "theater", "openingStardate", "highConcept", "openingMessage"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "theater": { "type": "string", "minLength": 1 },
        "openingStardate": { "type": "number" },
        "openingYear": { "type": "integer" },
        "highConcept": { "type": "string", "minLength": 1 },
        "openingMessage": { "type": "string", "minLength": 1 }
      }
    },
    "ship": {
      "type": "object",
      "required": ["id", "name", "class", "affiliation", "openingStardate", "openingCondition", "commandStructure"]
    },
    "crew": {
      "type": "object",
      "required": ["senior"],
      "properties": {
        "senior": { "type": "array", "minItems": 1 }
      }
    },
    "characterCreation": { "type": "object" },
    "world": {
      "type": "object",
      "required": ["id", "openingLocationId", "layout"]
    },
    "guardrails": {
      "type": "object",
      "required": ["simulationModes", "defaultSimulationMode"],
      "properties": {
        "simulationModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "defaultSimulationMode": { "type": "string", "minLength": 1 }
      }
    },
    "assets": {
      "type": "object",
      "required": ["images"],
      "properties": {
        "images": { "type": "array" }
      }
    }
  }
}
