{
  "kind": "directive.missionDefinition.v1",
  "schemaVersion": 1,
  "id": "mission.prelude-a-ship-underway",
  "version": "1.0.0",
  "packageBinding": {
    "packageId": "directive:campaign-package:breckenridge-ashes-of-peace",
    "packageVersion": "0.3.0-pre-alpha.1",
    "sourceId": "prelude-a-ship-underway"
  },
  "playerText": {
    "title": "Prelude: A Ship Underway",
    "summary": "Complete the command handover, establish a working command rhythm, and bring the Breckenridge to the Asterion Reach."
  },
  "projectionHints": {
    "shipReadinessObjectiveId": "objective.prelude.final-readiness-arrival",
    "shipReadinessDimensionId": "dimension.prelude.command-readiness"
  },
  "facts": [
    {
      "id": "fact.hesperus.distress-established",
      "initiallyTrue": false,
      "visibility": "discoverable",
      "playerText": {
        "summary": "The civilian transport Hesperus has transmitted a distress call requiring a Starfleet response."
      }
    },
    {
      "id": "fact.hesperus.passenger-risk",
      "initiallyTrue": true,
      "visibility": "discoverable",
      "playerText": {
        "summary": "Medically vulnerable passengers aboard Hesperus face material risk if aid is delayed."
      }
    },
    {
      "id": "fact.hesperus.injector-limit",
      "initiallyTrue": true,
      "visibility": "discoverable",
      "playerText": {
        "summary": "Hesperus can be stabilized, but its damaged injector cannot safely endure another warp restart."
      }
    },
    {
      "id": "fact.hesperus.record-inconsistency",
      "initiallyTrue": true,
      "visibility": "discoverable",
      "playerText": {
        "summary": "The Hesperus maintenance record contains an inconsistency that warrants review."
      }
    },
    {
      "id": "fact.hesperus.record-discrepancy",
      "initiallyTrue": true,
      "visibility": "discoverable",
      "playerText": {
        "summary": "Engineering has confirmed a material discrepancy in the Hesperus maintenance record."
      }
    },
    {
      "id": "fact.hesperus.record-falsified",
      "initiallyTrue": true,
      "visibility": "discoverable",
      "playerText": {
        "summary": "The available evidence confirms that an entry in the Hesperus maintenance record was deliberately falsified."
      }
    },
    {
      "id": "fact.hesperus.owner-attribution-supported",
      "initiallyTrue": true,
      "visibility": "discoverable",
      "playerText": {
        "summary": "The preserved evidence supports attributing the altered record to the vessel owner."
      }
    }
  ],
  "evidencePolicies": [
    {
      "id": "policy.hesperus.distress-established",
      "claimType": "worldFactEstablished",
      "targetId": "fact.hesperus.distress-established",
      "sourceRoles": ["runtime", "adjudicator"],
      "when": true
    },
    {
      "id": "policy.hesperus.distress-disclosed",
      "claimType": "factDisclosed",
      "targetId": "fact.hesperus.distress-established",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": { "worldFact": "fact.hesperus.distress-established" },
      "interpretation": {
        "evidenceStandard": "explicit",
        "guidance": "Claim only when accepted assistant prose communicates the Hesperus distress call to the player character.",
        "exclusions": ["A private signal, hidden alert, or unrelated mention of Hesperus does not establish player knowledge."]
      }
    },
    {
      "id": "policy.hesperus.passenger-risk-disclosed",
      "claimType": "factDisclosed",
      "targetId": "fact.hesperus.passenger-risk",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.passenger-risk" },
          { "factKnown": "fact.hesperus.distress-established" }
        ]
      },
      "interpretation": {
        "evidenceStandard": "explicit",
        "guidance": "Claim only when accepted assistant prose communicates the material risk to the medically vulnerable passengers.",
        "exclusions": ["General urgency or the existence of passengers alone does not communicate this assessed risk."]
      }
    },
    {
      "id": "policy.hesperus.injector-limit-disclosed",
      "claimType": "factDisclosed",
      "targetId": "fact.hesperus.injector-limit",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.injector-limit" },
          { "factKnown": "fact.hesperus.distress-established" }
        ]
      },
      "interpretation": {
        "evidenceStandard": "explicit",
        "guidance": "Claim only when accepted assistant prose reports that the damaged injector cannot safely endure another warp restart.",
        "exclusions": ["Generic engine trouble, uncertainty, or a proposed inspection does not establish this propulsion limit."]
      }
    },
    {
      "id": "policy.hesperus.record-inconsistency-disclosed",
      "claimType": "factDisclosed",
      "targetId": "fact.hesperus.record-inconsistency",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.record-inconsistency" },
          { "eventOccurred": "event.hesperus.records-reviewed" }
        ]
      },
      "interpretation": {
        "evidenceStandard": "explicit",
        "guidance": "Claim only when accepted assistant prose reports a specific inconsistency found in the reviewed maintenance record.",
        "exclusions": ["Beginning a records review or expressing suspicion does not establish that an inconsistency was found."]
      }
    },
    {
      "id": "policy.hesperus.record-discrepancy-disclosed",
      "claimType": "factDisclosed",
      "targetId": "fact.hesperus.record-discrepancy",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.record-discrepancy" },
          { "factKnown": "fact.hesperus.record-inconsistency" }
        ]
      },
      "interpretation": {
        "evidenceStandard": "explicit",
        "guidance": "Claim only when accepted assistant prose reports that the known record inconsistency has been confirmed as material.",
        "exclusions": ["An unexplained typo, suspicion, or unresolved inconsistency does not establish a material discrepancy."]
      }
    },
    {
      "id": "policy.hesperus.record-falsified-disclosed",
      "claimType": "factDisclosed",
      "targetId": "fact.hesperus.record-falsified",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.record-falsified" },
          { "factKnown": "fact.hesperus.record-discrepancy" }
        ]
      },
      "interpretation": {
        "evidenceStandard": "explicit",
        "guidance": "Claim only when accepted assistant prose communicates that evidence confirms deliberate falsification of a maintenance entry.",
        "exclusions": ["A discrepancy, negligence, suspicion, or possible fraud does not prove deliberate falsification."]
      }
    },
    {
      "id": "policy.hesperus.owner-attribution-disclosed",
      "claimType": "factDisclosed",
      "targetId": "fact.hesperus.owner-attribution-supported",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.owner-attribution-supported" },
          { "factKnown": "fact.hesperus.record-falsified" }
        ]
      },
      "interpretation": {
        "evidenceStandard": "explicit",
        "guidance": "Claim only when accepted assistant prose communicates that preserved evidence supports attributing the altered record to the vessel owner.",
        "exclusions": ["Motive, rumor, accusation, or confirmed falsification without actor evidence does not establish attribution."]
      }
    },
    {
      "id": "policy.prelude.command-handover-completed",
      "claimType": "eventOccurred",
      "targetId": "event.prelude.command-handover-completed",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": true,
      "interpretation": {
        "evidenceStandard": "clearOutcome",
        "guidance": "Claim only when accepted assistant prose depicts Whitaker and the player completing the substantive command handover and establishing authority or working boundaries.",
        "exclusions": ["A greeting, assignment announcement, invitation to talk, or handover still in progress is not completion."]
      }
    },
    {
      "id": "policy.prelude.staff-readiness-established",
      "claimType": "eventOccurred",
      "targetId": "event.prelude.staff-readiness-established",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": true,
      "interpretation": {
        "evidenceStandard": "clearOutcome",
        "guidance": "Claim only when accepted assistant prose depicts the senior staff reaching a workable delegation and readiness procedure with ownership and acknowledged limits.",
        "exclusions": ["Convening the staff, hearing concerns, issuing one isolated order, or planning the procedure is not enough."]
      }
    },
    {
      "id": "policy.hesperus.rescue-response-begun",
      "claimType": "eventOccurred",
      "targetId": "event.hesperus.rescue-response-begun",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": { "factKnown": "fact.hesperus.distress-established" },
      "interpretation": {
        "evidenceStandard": "clearOutcome",
        "guidance": "Claim only when accepted assistant prose depicts the Breckenridge actually committing resources or maneuver to the Hesperus response.",
        "exclusions": ["Discussing, evaluating, or proposing a rescue does not mean the response has begun."]
      }
    },
    {
      "id": "policy.hesperus.records-reviewed",
      "claimType": "eventOccurred",
      "targetId": "event.hesperus.records-reviewed",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": { "factKnown": "fact.hesperus.distress-established" },
      "interpretation": {
        "evidenceStandard": "clearOutcome",
        "guidance": "Claim only when accepted assistant prose depicts an actual review of the Hesperus maintenance records.",
        "exclusions": ["Ordering, planning, or suggesting a records review does not establish that it occurred."]
      }
    },
    {
      "id": "policy.hesperus.material-report-omitted",
      "claimType": "eventOccurred",
      "targetId": "event.hesperus.material-report-omitted",
      "sourceRoles": ["runtime", "adjudicator"],
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.passenger-risk" },
          { "not": { "factKnown": "fact.hesperus.passenger-risk" } }
        ]
      }
    },
    {
      "id": "policy.prelude.final-load-reviewed",
      "claimType": "eventOccurred",
      "targetId": "event.prelude.final-load-reviewed",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": {
        "all": [
          { "objectiveState": { "id": "objective.prelude.command-handover", "equals": "terminal" } },
          { "objectiveState": { "id": "objective.prelude.staff-readiness", "equals": "terminal" } },
          { "objectiveState": { "id": "objective.prelude.hesperus-rescue", "equals": "terminal" } }
        ]
      },
      "interpretation": {
        "evidenceStandard": "clearOutcome",
        "guidance": "Claim only when accepted assistant prose depicts completion of the combined-load test and final command-readiness review.",
        "exclusions": ["Scheduling, beginning, or discussing the final review does not establish completion."]
      }
    },
    {
      "id": "policy.prelude.arrival-reached",
      "claimType": "eventOccurred",
      "targetId": "event.prelude.arrival-reached",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": { "eventOccurred": "event.prelude.final-load-reviewed" },
      "interpretation": {
        "evidenceStandard": "clearOutcome",
        "guidance": "Claim only when accepted assistant prose depicts the Breckenridge actually arriving at the Asterion Reach.",
        "exclusions": ["Being en route, approaching, planning departure, or naming the destination is not arrival."]
      }
    },
    {
      "id": "policy.hesperus.rescue-risk-decision",
      "claimType": "decisionRecorded",
      "targetId": "outcome.hesperus.rescue-risk-decision",
      "sourceRoles": ["user"],
      "when": { "factKnown": "fact.hesperus.passenger-risk" },
      "interpretation": {
        "evidenceStandard": "explicit",
        "guidance": "Claim only when the player explicitly chooses how to respond to the known passenger risk.",
        "values": [
          { "value": "proceedKnownRisk", "guidance": "The player knowingly chooses the riskier immediate course." },
          { "value": "saferPlan", "guidance": "The player chooses a safer plan intended to mitigate the known risk." }
        ],
        "exclusions": ["A question, conditional idea, request for options, or uncommitted thought is not a decision."]
      }
    },
    {
      "id": "policy.hesperus.rescue-result",
      "claimType": "outcomeObserved",
      "targetId": "outcome.hesperus.rescue-result",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": {
        "any": [
          { "eventOccurred": "event.hesperus.rescue-response-begun" },
          { "eventOccurred": "event.hesperus.material-report-omitted" }
        ]
      },
      "interpretation": {
        "evidenceStandard": "clearOutcome",
        "guidance": "Claim only when accepted assistant prose depicts a settled disposition for the Hesperus rescue.",
        "values": [
          { "value": "safe", "guidance": "The people aboard Hesperus reach safety without a material recorded cost." },
          { "value": "safeWithCost", "guidance": "The people aboard Hesperus reach safety and the prose depicts a material cost or limitation." },
          { "value": "handedOff", "guidance": "Another competent authority explicitly assumes the remaining emergency response." },
          { "value": "failedInformed", "guidance": "The rescue fails after the player acted with the relevant risk already known." }
        ],
        "exclusions": ["A rescue attempt, response beginning, temporary stabilization, unresolved danger, or merely predicted result is not a settled rescue disposition."]
      }
    },
    {
      "id": "policy.hesperus.rescue-cost",
      "claimType": "outcomeObserved",
      "targetId": "outcome.hesperus.rescue-cost",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": { "factKnown": "fact.hesperus.distress-established" },
      "interpretation": {
        "evidenceStandard": "clearOutcome",
        "guidance": "Claim only when accepted assistant prose establishes whether the completed rescue incurred a material operational cost.",
        "values": [
          { "value": "none", "guidance": "The rescue concludes without a material cost or lasting limitation." },
          { "value": "material", "guidance": "The rescue concludes with a depicted material cost, delay, damage, exposure, or lasting limitation." }
        ],
        "exclusions": ["Routine effort, atmosphere, speculative risk, or a cost that has not occurred is not a material rescue cost."]
      }
    },
    {
      "id": "policy.hesperus.records-disposition",
      "claimType": "outcomeObserved",
      "targetId": "outcome.hesperus.records-disposition",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": { "factKnown": "fact.hesperus.record-discrepancy" },
      "interpretation": {
        "evidenceStandard": "clearOutcome",
        "guidance": "Claim only when accepted assistant prose depicts the actual disposition of the known record discrepancy.",
        "values": [
          { "value": "preliminaryHandOff", "guidance": "The discrepancy and supporting material are explicitly handed to a competent authority for follow-up." },
          { "value": "noAction", "guidance": "The scene settles with no action being taken on the known discrepancy." }
        ],
        "exclusions": ["Considering a handoff, asking for advice, or leaving the review unresolved is not a settled records disposition."]
      }
    },
    {
      "id": "policy.hesperus.accountability-decision",
      "claimType": "decisionRecorded",
      "targetId": "outcome.hesperus.accountability-decision",
      "sourceRoles": ["user"],
      "when": { "factKnown": "fact.hesperus.record-falsified" },
      "interpretation": {
        "evidenceStandard": "explicit",
        "guidance": "Claim only when the player explicitly chooses a disposition for the known falsification evidence.",
        "values": [
          { "value": "proportionateAction", "guidance": "The player orders or commits a proportionate accountability action." },
          { "value": "handOff", "guidance": "The player explicitly transfers the accountability decision and evidence to the proper authority." },
          { "value": "knowinglyDeclined", "guidance": "The player explicitly declines further accountability action while knowing falsification is confirmed." }
        ],
        "exclusions": ["Suspicion, moral reaction, a request for more evidence, or an unchosen option is not an accountability decision."]
      }
    },
    {
      "id": "policy.hesperus.accountability-result",
      "claimType": "outcomeObserved",
      "targetId": "outcome.hesperus.accountability-result",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": {
        "outcomeIs": {
          "id": "outcome.hesperus.accountability-decision",
          "in": ["proportionateAction", "handOff"]
        }
      },
      "interpretation": {
        "evidenceStandard": "clearOutcome",
        "guidance": "Claim only when accepted assistant prose depicts the result of a previously chosen accountability disposition.",
        "values": [
          { "value": "proportionateActionCommitted", "guidance": "The proportionate accountability action is actually committed or placed into effect." },
          { "value": "handedOff", "guidance": "The evidence and responsibility are actually transferred to the proper authority." },
          { "value": "evidenceLost", "guidance": "The known evidence is materially lost, destroyed, or rendered unusable." }
        ],
        "exclusions": ["An order, intention, or future promise alone does not prove that the accountability result occurred."]
      }
    },
    {
      "id": "policy.prelude.command-readiness",
      "claimType": "outcomeObserved",
      "targetId": "outcome.prelude.command-readiness",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": { "eventOccurred": "event.prelude.final-load-reviewed" },
      "interpretation": {
        "evidenceStandard": "clearOutcome",
        "guidance": "Claim only when accepted assistant prose reports the final reviewed command-readiness disposition.",
        "values": [
          { "value": "ready", "guidance": "The final review finds the command team ready without a material limitation." },
          { "value": "readyWithLimitation", "guidance": "The final review finds the command team ready while recording a material limitation." },
          { "value": "incompleteHonestlyReported", "guidance": "The final review remains incomplete and that limitation is honestly recorded rather than concealed." }
        ],
        "exclusions": ["Confidence, encouragement, an ongoing test, or a predicted result is not a final readiness disposition."]
      }
    },
    {
      "id": "policy.prelude.arrival-condition",
      "claimType": "outcomeObserved",
      "targetId": "outcome.prelude.arrival-condition",
      "sourceRoles": ["assistant", "runtime", "adjudicator"],
      "when": {
        "all": [
          { "eventOccurred": "event.prelude.arrival-reached" },
          {
            "outcomeIs": {
              "id": "outcome.prelude.command-readiness",
              "in": ["ready", "readyWithLimitation", "incompleteHonestlyReported"]
            }
          }
        ]
      },
      "interpretation": {
        "evidenceStandard": "clearOutcome",
        "guidance": "Claim only when accepted assistant prose depicts the Breckenridge's actual arrival condition at the Reach.",
        "values": [
          { "value": "onSchedule", "guidance": "The ship arrives on schedule without a material arrival limitation." },
          { "value": "delayed", "guidance": "The ship arrives after a material delay." },
          { "value": "withLimitation", "guidance": "The ship arrives with a material operational or readiness limitation." }
        ],
        "exclusions": ["Being en route, estimating arrival, or anticipating delay does not establish an arrival condition."]
      }
    },
    {
      "id": "policy.hesperus.authoritative-time",
      "claimType": "timeAdvanced",
      "targetId": "clock.hesperus-life-support",
      "sourceRoles": ["runtime", "adjudicator"],
      "when": { "clockState": { "id": "clock.hesperus-life-support", "equals": "running" } }
    }
  ],
  "reportRoutes": [
    {
      "id": "report.hesperus.distress",
      "factId": "fact.hesperus.distress-established",
      "evidencePolicyId": "policy.hesperus.distress-disclosed",
      "capabilityRoles": ["operations", "science"],
      "preferredActorIds": ["priya-nayar"],
      "fallbackActorIds": ["mara-whitaker"],
      "urgency": "urgent",
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.distress-established" },
          { "not": { "factKnown": "fact.hesperus.distress-established" } }
        ]
      },
      "playerText": { "summary": "Operations has received a civilian distress call requiring command attention." }
    },
    {
      "id": "report.hesperus.passenger-risk",
      "factId": "fact.hesperus.passenger-risk",
      "evidencePolicyId": "policy.hesperus.passenger-risk-disclosed",
      "capabilityRoles": ["medical"],
      "preferredActorIds": ["miriam-sato"],
      "fallbackActorIds": ["mara-whitaker"],
      "urgency": "urgent",
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.passenger-risk" },
          { "factKnown": "fact.hesperus.distress-established" },
          { "not": { "factKnown": "fact.hesperus.passenger-risk" } }
        ]
      },
      "playerText": { "summary": "Medical has a material passenger-risk assessment to report." }
    },
    {
      "id": "report.hesperus.injector-limit",
      "factId": "fact.hesperus.injector-limit",
      "evidencePolicyId": "policy.hesperus.injector-limit-disclosed",
      "capabilityRoles": ["engineering"],
      "preferredActorIds": ["hadrik-bronn", "imani-cross"],
      "fallbackActorIds": ["mara-whitaker"],
      "urgency": "material",
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.injector-limit" },
          { "factKnown": "fact.hesperus.distress-established" },
          { "not": { "factKnown": "fact.hesperus.injector-limit" } }
        ]
      },
      "playerText": { "summary": "Engineering has identified a material propulsion limitation aboard Hesperus." }
    },
    {
      "id": "report.hesperus.record-inconsistency",
      "factId": "fact.hesperus.record-inconsistency",
      "evidencePolicyId": "policy.hesperus.record-inconsistency-disclosed",
      "capabilityRoles": ["engineering", "operations"],
      "preferredActorIds": ["hadrik-bronn", "priya-nayar"],
      "fallbackActorIds": ["mara-whitaker"],
      "urgency": "routine",
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.record-inconsistency" },
          { "eventOccurred": "event.hesperus.records-reviewed" },
          { "not": { "factKnown": "fact.hesperus.record-inconsistency" } }
        ]
      },
      "playerText": { "summary": "The Hesperus records review found an inconsistency worth command attention." }
    },
    {
      "id": "report.hesperus.record-discrepancy",
      "factId": "fact.hesperus.record-discrepancy",
      "evidencePolicyId": "policy.hesperus.record-discrepancy-disclosed",
      "capabilityRoles": ["engineering", "operations"],
      "preferredActorIds": ["hadrik-bronn", "priya-nayar"],
      "fallbackActorIds": ["mara-whitaker"],
      "urgency": "material",
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.record-discrepancy" },
          { "factKnown": "fact.hesperus.record-inconsistency" },
          { "not": { "factKnown": "fact.hesperus.record-discrepancy" } }
        ]
      },
      "playerText": { "summary": "Engineering has confirmed that the record inconsistency is material." }
    },
    {
      "id": "report.hesperus.record-falsified",
      "factId": "fact.hesperus.record-falsified",
      "evidencePolicyId": "policy.hesperus.record-falsified-disclosed",
      "capabilityRoles": ["operations", "security"],
      "preferredActorIds": ["priya-nayar", "rowan-saye"],
      "fallbackActorIds": ["mara-whitaker"],
      "urgency": "material",
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.record-falsified" },
          { "factKnown": "fact.hesperus.record-discrepancy" },
          { "not": { "factKnown": "fact.hesperus.record-falsified" } }
        ]
      },
      "playerText": { "summary": "The preserved record evidence now supports a formal accountability decision." }
    },
    {
      "id": "report.hesperus.owner-attribution",
      "factId": "fact.hesperus.owner-attribution-supported",
      "evidencePolicyId": "policy.hesperus.owner-attribution-disclosed",
      "capabilityRoles": ["operations", "security"],
      "preferredActorIds": ["priya-nayar", "rowan-saye"],
      "fallbackActorIds": ["mara-whitaker"],
      "urgency": "routine",
      "when": {
        "all": [
          { "worldFact": "fact.hesperus.owner-attribution-supported" },
          { "factKnown": "fact.hesperus.record-falsified" },
          { "not": { "factKnown": "fact.hesperus.owner-attribution-supported" } }
        ]
      },
      "playerText": { "summary": "The evidence trail now supports identifying a responsible party." }
    }
  ],
  "events": [
    {
      "id": "event.prelude.command-handover-completed",
      "playerVisibility": "visible",
      "playerText": { "summary": "Captain Whitaker and the new XO completed the command handover." }
    },
    {
      "id": "event.prelude.staff-readiness-established",
      "playerVisibility": "visible",
      "playerText": { "summary": "The senior staff established delegation and readiness procedures." }
    },
    {
      "id": "event.hesperus.rescue-response-begun",
